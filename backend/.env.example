# MongoDB
MONGODB_URI=mongodb://localhost:27017/guardianai

# JWT
JWT_SECRET=change-this-super-secret-key-for-guardianai-jwt-signing-min-256-bits
JWT_EXPIRATION=86400000

# Gemini AI (optional - system works fully without it via local anomaly engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# App
PORT=8080
ALERT_TIMEOUT_SECONDS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
