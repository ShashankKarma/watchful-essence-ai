# MongoDB
# For Atlas, use the SRV connection string copied from Atlas. Keep credentials
# URL-encoded and restrict the Atlas network access list to your deployment.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/guardianai?retryWrites=true&w=majority&serverSelectionTimeoutMS=10000&connectTimeoutMS=10000&socketTimeoutMS=10000
MONGODB_AUTO_INDEX_CREATION=true

# JWT
JWT_SECRET=change-this-super-secret-key-for-guardianai-jwt-signing-min-256-bits
JWT_EXPIRATION=86400000

# Gemini AI (optional - system works fully without it via local anomaly engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# App
PORT=8080
ALERT_TIMEOUT_SECONDS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Required for the write/read/delete persistence smoke test endpoint.
HEALTH_CHECK_TOKEN=replace-with-a-long-random-deployment-health-token
